__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
build/
.pytest_cache/
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
# Per-install dev fallback for TBDTASK_SECRET_KEY. Hosted deployments
# must set the env var explicitly; the file shouldn't ship in git.
data/secret_key
.env

# Build artifacts: keep the final AppImages, throw away the intermediate
# downloads + AppDir staging tree.
dist/*
!dist/*.AppImage

# Tauri / Rust build artifacts. Cargo.lock is committed for reproducible
# release builds (this is a binary, not a library).
desktop/src-tauri/target/
# Auto-generated by tauri-build from tauri.conf.json on every build.
desktop/src-tauri/gen/schemas/
