# tbdtask environment variables for hosted deployments.
# Copy to .env and fill in real values. NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# HMAC signing key for CSRF tokens, OIDC state, and session signatures.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Different per environment.
TBDTASK_SECRET_KEY=

# Postgres connection string. Use the psycopg3 SQLAlchemy driver.
# Format: postgresql+psycopg://user:pass@host:port/dbname
# For local dev: postgresql+psycopg://tbdtask:tbdtask@localhost:5432/tbdtask
DATABASE_URL=

# ---------------------------------------------------------------------------
# OIDC providers (enable only the ones you need)
# ---------------------------------------------------------------------------

# Google
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=

# Microsoft
# OIDC_MICROSOFT_CLIENT_ID=
# OIDC_MICROSOFT_CLIENT_SECRET=

# Apple
# OIDC_APPLE_CLIENT_ID=
# OIDC_APPLE_CLIENT_SECRET=
# OIDC_APPLE_TEAM_ID=
# OIDC_APPLE_KEY_ID=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Trusted proxy CIDRs (comma-separated). Defaults to loopback only.
# Set explicitly to your reverse proxy/load balancer CIDRs in hosted mode.
# TBDTASK_TRUSTED_PROXIES=10.0.0.0/24

# Single-tenant mode (AppImage). Set to 1 to disable auth surface.
# TBDTASK_SINGLE_TENANT=0

# Data directory for SQLite (AppImage only; ignored in hosted mode).
# TBDTASK_DATA_DIR=/path/to/data

# Local-only HTTP screenshot/testing cookie mode. Never set in hosted mode.
# TBDTASK_INSECURE_LOCAL_COOKIES=0
